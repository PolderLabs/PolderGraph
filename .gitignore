__pycache__/
*.py[cod]
*$py.class
*.egg-info/
/dist/
**/dist/*
# The dashboard that ships to users: api/server.py serves it and every
# distribution packages it, so it is tracked rather than ignored. Its index.html
# carries hashed asset references, so ignoring the assets/ directory yields a
# distribution whose dashboard loads nothing.
!src/poldergraph/web/dist/
!src/poldergraph/web/dist/**
build/
*.egg
.eggs/
*.so

.venv/
venv/
env/

node_modules/
.web/

.poldergraph/
.poldergraph.backup/
.poldergraph.rebuild/

*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

*.log
.DS_Store
Thumbs.db

.pytest_cache/
.mypy_cache/
.ruff_cache/

# The dashboard build outputs to src/poldergraph/web/dist (Vite outDir). That is
# the copy the Python server serves and the one every distribution packages, so
# it is tracked: a release built without `pnpm build` would otherwise ship an
# index.html whose hashed asset references 404, which is a blank dashboard.
# web/dist no longer exists as a build target; keep it ignored in case an old
# checkout still has one lying around.
web/dist/*